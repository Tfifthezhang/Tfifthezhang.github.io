---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? site.lang;
const currentPath = stripLocale(stripBase(Astro.url.pathname), locale).replace(
  /\/+$/,
  ""
);
const links = [
  { label: "Posts", path: "posts", enabled: true },
  { label: "Archive", path: "archives", enabled: features.showArchives },
  { label: "Search", path: "search", enabled: features.search !== false },
  { label: "Tags", path: "tags", enabled: true },
  { label: "About", path: "about", enabled: true },
].filter(link => link.enabled);
const isActive = (path: string) =>
  (path === "posts" && currentPath === "") ||
  currentPath === `/${path}` ||
  currentPath.startsWith(`/${path}/`);
---

<a id="skip-to-content" class="skip-link" href="#main-content"
  >Skip to content</a
>
<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <div class="site-brand">
      <a class="site-title" href={getRelativeLocaleUrl(locale, "")}
        >{site.title}</a
      >
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="theme-toggle"
            title="Toggle theme"
            aria-label="Toggle theme"
            aria-live="polite"
          >
            <IconMoon class="light-icon" />
            <IconSunHigh class="dark-icon" />
          </button>
        )
      }
    </div>
    <ul class="site-menu">
      {
        links.map(link => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, link.path)}
              class:list={{ active: isActive(link.path) }}
              aria-current={isActive(link.path) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  function setupSkipLink() {
    document
      .getElementById("skip-to-content")
      ?.addEventListener("click", event => {
        if (
          event.defaultPrevented ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.button !== 0
        )
          return;
        const main = document.getElementById("main-content");
        if (!main) return;
        event.preventDefault();
        main.setAttribute("tabindex", "-1");
        main.addEventListener("blur", () => main.removeAttribute("tabindex"), {
          once: true,
        });
        main.focus();
        main.scrollIntoView();
      });
  }
  setupSkipLink();
  document.addEventListener("astro:after-swap", setupSkipLink);
</script>
