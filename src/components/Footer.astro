---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const platformNames: Record<string, string> = {
  github: "GitHub",
  x: "X",
  linkedin: "LinkedIn",
  mail: "Email",
  facebook: "Facebook",
  telegram: "Telegram",
  whatsapp: "WhatsApp",
  pinterest: "Pinterest",
};
---

<footer
  class:list={[
    "app-layout site-footer",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <span
    >© {new Date().getFullYear()}{" "}
    <a href={getRelativeLocaleUrl(locale, "")}>{config.site.title}</a></span
  >
  <span aria-hidden="true">·</span>
  <a href={getRelativeLocaleUrl(locale, "rss.xml")}>RSS</a>
  {
    config.socials.map(link => (
      <Fragment>
        <span aria-hidden="true">·</span>
        <a href={link.url} title={link.linkTitle}>
          {platformNames[link.name] ?? link.name}
        </a>
      </Fragment>
    ))
  }
</footer>
