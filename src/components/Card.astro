---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import PostMeta from "./PostMeta.astro";
import { getReadingTime } from "@/utils/getReadingTime";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, author, pubDatetime, timezone } = data;
---

<li class="post-entry">
  <a href={getPostUrl(id, filePath, Astro.currentLocale)} class="entry-link">
    <Heading class="entry-title" transition:name={toTransitionName(id)}>
      {title}
    </Heading>
    <p class="entry-summary">{description}</p>
    <PostMeta
      {pubDatetime}
      {timezone}
      {author}
      minutes={getReadingTime(body)}
    />
  </a>
</li>
